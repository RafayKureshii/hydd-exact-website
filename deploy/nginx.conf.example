# Example only: adapt paths and SSL certificates to your personal server.
# Serve the French original URLs AND EN/AR path prefixes from the same host.
server {
    listen 443 ssl http2;
    server_name www.hydd.fr;
    ssl_certificate /etc/letsencrypt/live/www.hydd.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.hydd.fr/privkey.pem;
    root /srv/hydd-static/dist;
    index index.html;
    location / { try_files $uri $uri/ $uri/index.html =404; }
    location /api/contact {
        proxy_pass http://127.0.0.1:8123/api/contact;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location ~* ^/(assets|hydd)/ {
        expires 7d;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
}
server { listen 80; server_name www.hydd.fr; return 301 https://www.hydd.fr$request_uri; }
